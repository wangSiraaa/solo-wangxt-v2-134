# Fluorescence channel unmixing platform configuration
UNMIX_DATABASE_URL=postgresql+psycopg2://unmix:unmix@postgres:5432/unmix
UNMIX_OBJECT_STORE=minio
UNMIX_MINIO_ENDPOINT=minio:9000
UNMIX_MINIO_ACCESS_KEY=minioadmin
UNMIX_MINIO_SECRET_KEY=minioadmin
UNMIX_MINIO_BUCKET=unmix
UNMIX_CELERY_BROKER_URL=redis://redis:6379/0
UNMIX_CELERY_RESULT_BACKEND=redis://redis:6379/1
UNMIX_TILE_SIZE=512
UNMIX_MAX_TILE_ATTEMPTS=3
UNMIX_MATRIX_COND_WARN=50
# Override every seeded key in real deployments
UNMIX_SEED_ADMIN_KEY=change-me-admin
UNMIX_SEED_IMAGER_KEY=change-me-imager
UNMIX_SEED_ANALYST_KEY=change-me-analyst
UNMIX_SEED_MATRIXER_KEY=change-me-matrixer
UNMIX_SEED_PUBLISHER_KEY=change-me-publisher
